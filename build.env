# Fork build env — REQUIRED for every release build. Recovered 2026-09-01
# from the baked constants in the good 0.2.3 release after 0.2.4/0.2.5
# shipped without it (esbuild fell back to upstream System 3 URLs and every
# updated device silently lost the hub).
#
# Usage:
#   cd ~/projects/Relay
#   set -a; source ~/projects/woolly-relay-dist/build.env; set +a
#   npm run release
#   cd ~/projects/woolly-relay-dist && ./release.sh <version>
#
# RELAY_FORK_OPERATOR is a deliberate sentinel: nobody is operator, so every
# device gets the minimal "sign in and your folders appear" settings surface.
RELAY_FORK_API_URL=https://woolly.08d5743r4qj3w.com
RELAY_FORK_AUTH_URL=https://woolly.08d5743r4qj3w.com
RELAY_FORK_REPOSITORY=PicoBEAN-eng/woolly-relay
RELAY_FORK_OPERATOR=nobody@woolly.invalid
